{
  "name": "enphase-tesla",
  "version": "0.1.0",
  "private": true,
  "description": "Per-second Enphase logger and dashboard that charges a Tesla from excess solar over local Bluetooth.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "probe": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/probe.js"
  },
  "dependencies": {
    "mqtt": "5.10.4",
    "protobufjs": "7.4.0",
    "uplot": "1.6.31"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pureyang/enphase-tesla"
  }
}
