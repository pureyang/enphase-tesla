# Copy to .env and fill in. .env is git-ignored and never leaves this PC.

# --- Enlighten account: used once a year to get a local gateway token (Enphase's documented method).
# Skip both if you paste GATEWAY_TOKEN below instead.
ENLIGHTEN_EMAIL=
ENLIGHTEN_PASSWORD=

# --- Optional: Enlighten cloud features. Off by default.
# 1 = also use Enlighten's web endpoints: 15-min history (up to 92 days back, so the EV advisor learns
# faster), a cloud live stream when the gateway is unreachable, and gateway serial lookup.
# These endpoints aren't a published API and Enphase's Terms of Service may not allow automated use.
# 0 = everything comes from your own gateway on your own network.
ENLIGHTEN_CLOUD=0
# Site id from the Enlighten URL: enlighten.enphaseenergy.com/web/<SITE_ID>/... (cloud features only)
ENLIGHTEN_SITE_ID=

# --- Local IQ Gateway (Envoy)
# IP or hostname on your LAN, e.g. 192.168.1.50 or envoy.local
GATEWAY_HOST=envoy.local
# Gateway serial (Enlighten app > Menu > System > Devices > Gateway). Required.
GATEWAY_SERIAL=
# Optional: paste a token from https://entrez.enphaseenergy.com instead of auto-minting.
GATEWAY_TOKEN=

# --- EV advisor
# ZIP (US) or city for the weather forecast, or set LAT/LON directly.
LOCATION=
LAT=
LON=
# Tesla Mobile Connector on 240 V: 5-32 A
EV_MIN_AMPS=5
EV_MAX_AMPS=32
# Plan with this fraction of forecast solar (lower = protects house battery more)
EV_SAFETY=0.85
# House battery must reach this SOC before solar fades
EV_TARGET_SOC=99
NOTIFY_MIN_INTERVAL_MIN=60

# --- Optional: phone push notifications via ntfy (https://ntfy.sh). Off by default.
# 1 = send start/stop pushes to your phone; 0 = show messages on the dashboard only
NOTIFY=0
# Leave blank to auto-generate a private topic (shown on the EV tab)
NTFY_TOPIC=

# --- Optional: full per-second history. Off by default.
# 0 = keep per-second data for the last HISTORY_HOURS (min 26) plus minute averages forever (~130 MB/yr)
# 1 = keep every per-second row forever (~20 GB/yr) for zooming into any past second
RECORD_HISTORY=0
HISTORY_HOURS=26

# --- App
PORT=8787
# 127.0.0.1 = this PC only; 0.0.0.0 = reachable from other devices on your LAN
HOST=127.0.0.1
# Which source to prefer: local | cloud
PREFERRED_SOURCE=local
# Seconds without fresh local data before falling back to cloud
FALLBACK_AFTER_S=10

# --- Optional: Tesla control. Needs the M5Stack NanoC6 Bluetooth bridge (see README); ignored without it.
# Bridge address and web login (installer fills these in)
TESLA_BLE_HOST=
TESLA_BLE_USER=
TESLA_BLE_PASSWORD=
# 1 = drive the car's charging over Bluetooth, 0 = advice only
EV_AUTO_CONTROL=1
# Seconds between updates to the car (min 30)
EV_CONTROL_INTERVAL_S=60
# Optional first day (YYYY-MM-DD) to take control
EV_AUTO_FROM=
# Minutes to back off after you change charging in the Tesla app
EV_OVERRIDE_MIN=120
# Usable car pack size (kWh), for the expected-SOC estimate in pushes
EV_CAR_KWH=75
# When the house battery is full and the car reaches its limit, raise the limit to this (0 = off); restored after sunset
EV_LIMIT_RAISE_TO=90
# Wh a day the car may borrow from the house battery to ride through a cloud at min amps (repaid from solar)
EV_LOAN_WH=200
